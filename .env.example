# .env.example - 环境变量模板
# 复制此文件为 .env 并填入实际值

# ===== 摘要配置 =====
# 摘要注入轮数（每个摘要会在接下来的 N 轮对话中注入）
WAKE_DIGEST_TURNS=5

# ===== 调度器配置 =====
# 沉默阈值（分钟）：用户沉默超过此时间才触发唤醒
WAKE_THRESHOLD_MINUTES=60

# 摘要文件存放目录（默认当前目录）
DIGEST_BASE_DIR=./

# ===== LLM 配置（需要填写）=====
# 上游 LLM API 地址
UPSTREAM_API_URL=https://api.openai.com/v1/chat/completions

# API 密钥
UPSTREAM_API_KEY=sk-your-api-key-here

# 模型名称
MODEL_NAME=gpt-4

# ===== 可选：AI 和用户称呼 =====
AI_NAME=AI
USER_NAME=用户
